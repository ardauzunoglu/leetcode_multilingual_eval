FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        gcc \
        g++ \
        libc6-dev \
        libstdc++-14-dev \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# The judge invokes `python`, matching the other runtime command names.
RUN ln -s /usr/bin/python3 /usr/local/bin/python

WORKDIR /work

